<Window x:Class="Lindrop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="邻渡 · Lindrop" Icon="Assets/Lindrop.png" Width="940" Height="650" MinWidth="720" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI"
        FontSize="14" Background="Transparent" Foreground="#222326" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop">
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Glass.xaml"/></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="Secondary" Color="#62656E"/>
    <SolidColorBrush x:Key="Tint" Color="#EDEFF4"/>
    <SolidColorBrush x:Key="Accent" Color="#1265D6"/>
    <Style TargetType="Button" x:Key="Pill">
      <Setter Property="Background" Value="{StaticResource Tint}"/>
      <Setter Property="Foreground" Value="#222326"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#CCFFFFFF"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="14" Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.58"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="#84B2F5"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.44"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="12,9"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="Selected">
          <Setter Property="Background" Value="#E1E7F1"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7EAF0"/></Trigger>
      </Style.Triggers>
    </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="9">
  <Border CornerRadius="27" Background="#F7FAFE" IsHitTestVisible="False">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#25334B"/></Border.Effect>
  </Border>
  <Border CornerRadius="27" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
          Background="{StaticResource GlassFill}">
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="17,5,10,0">
      <TextBlock Text="邻渡" Foreground="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="7,0"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="17"
              Background="#AFFFFFFF" BorderBrush="#CBD5E3" BorderThickness="1" Padding="3,1">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Quiet}" Width="34" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="Minimize_Click"/>
        <Button Style="{StaticResource Quiet}" Width="34" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" Content="&#xE922;" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" Click="Maximize_Click"/>
        <Button Style="{StaticResource Quiet}" Width="34" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" Content="&#xE8BB;" ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘" Click="CloseWindow_Click"/>
      </StackPanel>
      </Border>
    </Grid>
  <Grid Grid.Row="1" Margin="9,0,9,9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#82E7ECF4" BorderBrush="#BFFFFFFF" BorderThickness="1" CornerRadius="22" Padding="13,18,13,14" Margin="0,0,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="7,0,0,23">
            <Image Width="32" Height="32" Source="Assets/Lindrop.png"/>
            <TextBlock Text="邻渡" FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="TransferNav" Tag="Selected" Style="{StaticResource Nav}" Click="TransferPage_Click" Content="传输"/>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="SettingsPage_Click" Content="设置"/>
          <Button Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Content="打开接收目录" Click="Inbox_Click" Margin="0,16,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="6,0">
          <Border Height="1" Background="#DADCE4" Margin="0,0,0,11"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#319462" Margin="0,0,7,0"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Secondary}" FontSize="12" Width="126" TextTrimming="CharacterEllipsis" Text="正在启动…"/>
          </StackPanel>
          <TextBlock Text="兼容小米互传 · 非官方客户端" Foreground="{StaticResource Secondary}"
                     FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24,13,19,16" Grid.IsSharedSizeScope="True">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Height="40" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="RecordActions"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="SearchActions"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitle" Text="传输" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="StopTransfer" Grid.Column="1" Style="{StaticResource Pill}" Width="132" Margin="0,0,8,0"
                Content="停止本次传输" Click="StopTransfer_Click" IsEnabled="False"/>
        <Button Grid.Column="2" HorizontalAlignment="Right" Width="160" Style="{StaticResource Primary}" Click="Browse_Click" Content="发送文件"/>
      </Grid>
      <Grid x:Name="TransferPane" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="DropZone" Background="Transparent" Margin="0,0,0,21">
          <Border BorderThickness="1" CornerRadius="23" Padding="18,18" RenderTransformOrigin="0.5,0.5">
            <Border.Background><SolidColorBrush x:Name="DropFill" Color="#F1F3F7"/></Border.Background>
            <Border.BorderBrush><SolidColorBrush x:Name="DropStroke" Color="#E4E7EF"/></Border.BorderBrush>
            <Border.RenderTransform><ScaleTransform x:Name="DropScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock x:Name="DropLabel" Text="将文件拖到这里发送" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,10" Height="34">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="RecordActions"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="SearchActions"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Search" Grid.Column="2" HorizontalAlignment="Right" Width="160" Height="34" FontSize="13" Padding="12,5" VerticalContentAlignment="Center"
                   BorderBrush="#D8DAE2" Background="White" AutomationProperties.Name="搜索历史记录" TextChanged="Search_Changed" GotKeyboardFocus="Search_FocusChanged" LostKeyboardFocus="Search_FocusChanged" ToolTip="搜索文件、设备或方向"/>
          <Button x:Name="RemoveSelected" Grid.Column="1" Width="132" Style="{StaticResource Pill}" Margin="0,0,8,0"
                  Content="移除所选记录" Click="RemoveSelected_Click" IsEnabled="False"/>
          <TextBlock Text="历史记录" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="2" CornerRadius="22" BorderThickness="1" BorderBrush="#DDE3EC" Background="#AFFFFFFF" Padding="3,8">
          <Grid>
            <TextBlock x:Name="HistoryEmpty" Text="还没有传输记录" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     SelectionMode="Extended" SelectionChanged="HistorySelection_Changed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="15" Padding="5,7">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="34"/><ColumnDefinition Width="30"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="选择此记录"
                                IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
                      <StackPanel Grid.Column="1" Margin="8,2,0,2">
                        <Button Style="{StaticResource Quiet}" Height="24" FontSize="14" Click="Open_Click"
                                HorizontalContentAlignment="Left" Padding="0" Foreground="#25262C">
                          <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </Button>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource Secondary}" FontSize="12"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,12,0"/>
                      <Button Grid.Column="3" Width="30" Height="30" Style="{StaticResource Quiet}" Click="Reveal_Click"
                              ToolTip="在资源管理器中显示" AutomationProperties.Name="打开文件位置" Content="&#xE838;"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="0"/>
                      <Button Grid.Column="4" Width="30" Height="30" Style="{StaticResource Quiet}" Click="HistoryMenu_Click"
                              ToolTip="文件与记录操作" AutomationProperties.Name="文件与记录操作" Content="⋯" FontSize="16" Padding="0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
      <ScrollViewer x:Name="SettingsPane" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="存储" FontSize="12" Foreground="{StaticResource Secondary}" Margin="2,0,0,7"/>
          <Border Background="#CFFFFFFF" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="22" Padding="18">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="更改…" Click="Folder_Click"/>
                <StackPanel><TextBlock Text="接收文件保存位置" FontWeight="SemiBold"/><TextBlock x:Name="FolderText" FontSize="12" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,3,8,0"/></StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="Windows" FontSize="12" Foreground="{StaticResource Secondary}" Margin="2,20,0,7"/>
          <Border Background="#CFFFFFFF" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="22" Padding="18">
            <StackPanel>
              <CheckBox x:Name="StartupCheck" Content="登录时在托盘启动" Click="Startup_Click" Padding="8,0,0,0" MinHeight="24"/>
              <Border Height="1" Background="#EBECF0" Margin="0,11"/>
              <CheckBox x:Name="MenuCheck" Content="在资源管理器中显示「用邻渡发送」" Click="Menu_Click" Padding="8,0,0,0" MinHeight="24"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
  </Grid>
  </Border>
  </Grid>
</Window>
