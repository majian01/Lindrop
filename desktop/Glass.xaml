<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.6,1">
    <GradientStop Color="#FCFFFFFF" Offset="0"/>
    <GradientStop Color="#EDEFF4FA" Offset="0.55"/>
    <GradientStop Color="#F8FAFCFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#B9D8DFEC" Offset="0.55"/>
    <GradientStop Color="#F2FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#BFFFFFFF"/>
    <Setter Property="BorderBrush" Value="#DCE2ED"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="18">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="#719FE1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="#303747"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border CornerRadius="14" Background="{StaticResource GlassFill}" BorderBrush="#D4DDEB"
                BorderThickness="1" Padding="12,8">
          <ContentPresenter/>
        </Border>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" Margin="1,5">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
            <Track.Thumb>
              <Thumb MinHeight="24">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border CornerRadius="5" Background="#809AA6B8" Margin="1"/>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#303747"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Ring" CornerRadius="9" Width="18" Height="18" BorderThickness="1"
                    BorderBrush="#A8B3C5" Background="#EFFFFFFF" VerticalAlignment="Center">
              <TextBlock x:Name="Mark" Text="✓" FontSize="12" FontWeight="SemiBold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Background" Value="#246AD2"/>
              <Setter TargetName="Ring" Property="BorderBrush" Value="#246AD2"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#246AD2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="3"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" CornerRadius="15" Margin="5,2" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#7FE9EEF7"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DCE9F9"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#88AFE5"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Background" Value="#DCE3EF"/>
    <Setter Property="Foreground" Value="#2876E1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="8"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.45"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity"
                                   From="0.25" To="0.85" Duration="0:0:0.8"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Grid Margin="8" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
          <Border CornerRadius="18" Background="White" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.15"/></Border.Effect>
          </Border>
          <Border Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassEdge}"
                  BorderThickness="1" CornerRadius="18" Padding="5">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </Grid>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Item" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#DCE9F9"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
